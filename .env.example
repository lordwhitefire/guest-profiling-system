# =============================================================================
# Guest Profiling System — environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All values shown here are placeholders.

# ── Database ────────────────────────────────────────────────────────────────
# Our own database (the clean, profile-shaped one). Must be Postgres 15+.
DATABASE_URL=postgres://postgres:dev@localhost:5432/gps

# ── Auth ───────────────────────────────────────────────────────────────────
# JWT signing secret. MUST be a 256-bit (32-byte) random hex string.
# Generate with: `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_TO_A_32_BYTE_HEX_STRING

# Argon2id pepper — appended to passwords before hashing.
# MUST be a 32-byte random hex string. Generate with: `openssl rand -hex 32`
ARGON2_PEPPER=CHANGE_ME_TO_A_32_BYTE_HEX_STRING

# JWT expiration in seconds (default: 86400 = 24 hours)
JWT_EXPIRES_IN_SECONDS=86400

# ── Source PMS (adapter-read) ───────────────────────────────────────────────
# Read-only connection URL to the hotel's PMS database.
# MUST include `default_transaction_read_only=true` in the query string.
SOURCE_PMS_URL=postgres://readonly_user:CHANGE_ME@pms-host:5432/pms?default_transaction_read_only=true

# Which PMS vendor? Drives the source-mapping rules. One of: qloapps | mews | cloudbeds | apaleo | custom
SOURCE_PMS_TYPE=qloapps

# Sync interval in seconds (default: 300 = 5 minutes)
SYNC_INTERVAL_SECONDS=300

# Sync throttle percentage — max source DB utilization (default: 75)
SYNC_THROTTLE_PERCENT=75

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3000
# Do NOT set NODE_ENV here. Next.js sets it per command (dev/build) and Next 16
# fails to prerender /_global-error if NODE_ENV=development is present at build.

# ── Tenant (single-tenant deploy only; multi-tenant uses DB) ────────────────
# The tenant_id for this install. Generate with: `openssl rand -hex 16` (UUID format)
DEFAULT_TENANT_ID=CHANGE_ME

# ── Encryption (for sensitive fields at rest) ───────────────────────────────
# AES-256 key for encrypting identity documents and adapter connection URLs.
# MUST be a 32-byte random hex string. Generate with: `openssl rand -hex 32`
FIELD_ENCRYPTION_KEY=CHANGE_ME_TO_A_32_BYTE_HEX_STRING
