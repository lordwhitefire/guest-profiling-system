index 0000000..1f5f935
--- /dev/null
+++ b/packages/adapter-fill-extension/src/fill/native-setter.ts
@@ -0,0 +1,265 @@
+// =============================================================================
+// Native prototype setter — framework-safe value writes
+// =============================================================================
+// Per Card 5 §7.4: "Plain element.value = x assignments fail silently on
+// React/Vue/Angular pages because the framework installs a value tracker
+// on the instance that marks the assignment as already-seen, suppressing
+// the onChange callback. FormFilla bypasses this by calling the value setter
+// defined on the element's PROTOTYPE directly (via Function.prototype.call),
+// which the framework's instance-level wrapper cannot intercept."
+//
+// After the value is set, two events are dispatched to match what a real
+// user edit produces:
+//   - Event 1: input (bubbles=true, composed=true, inputType='insertReplacementText')
+//   - Event 2: change (bubbles=true, composed=true)
+//
+// Defense in depth (Card 5 §7.4): "if the page has somehow replaced the
+// prototype's own value descriptor, the prototype lookup fails silently and
+// falls back to plain el.value = x. A second fallback uses a hidden
+// same-origin about:blank iframe's untouched copy of the same built-in
+// prototype."
+//
+// We provide THREE fallback tiers:
+//   1. Native prototype setter via HTMLInputElement.prototype lookup
+//   2. Plain el.value = x
+//   3. Pristine-iframe prototype (created on demand, cached)
+
+export type SetterOutcome = "prototype" | "plain" | "iframe" | "select" | "failed";
+
+export interface SetResult {
+  outcome: SetterOutcome;
+  element: Element;
+  value: string;
+  /** Whether input + change events were dispatched. */
+  eventsDispatched: boolean;
+}
+
+/**
+ * Set a value on a form element using the native prototype setter bypass.
+ *
+ * Handles input, textarea, and select elements. Checkboxes and radios are
+ * set via .checked = (value === "true" || value === "on").
+ */
+export function setValue(element: Element, value: string): SetResult {
+  const tagName = element.tagName.toLowerCase();
+
+  if (tagName === "select") {
+    return setSelectValue(element as HTMLSelectElement, value);
+  }
+  if (tagName === "textarea") {
+    return setTextAreaValue(element as HTMLTextAreaElement, value);
+  }
+  if (tagName === "input") {
+    const input = element as HTMLInputElement;
+    if (input.type === "checkbox" || input.type === "radio") {
+      return setCheckboxValue(input, value);
+    }
+    return setInputValue(input, value);
+  }
+
+  return { outcome: "failed", element, value, eventsDispatched: false };
+}
+
+function setInputValue(input: HTMLInputElement, value: string): SetResult {
+  // Tier 1: native prototype setter bypass
+  try {
+    const proto = HTMLInputElement.prototype;
+    const descriptor = Object.getOwnPropertyDescriptor(proto, "value");
+    if (descriptor && descriptor.set) {
+      descriptor.set.call(input, value);
+      dispatchEvents(input);
+      return { outcome: "prototype", element: input, value, eventsDispatched: true };
+    }
+  } catch {
+    // Fall through to tier 2
+  }
+
+  // Tier 2: plain el.value = x
+  try {
+    input.value = value;
+    dispatchEvents(input);
+    return { outcome: "plain", element: input, value, eventsDispatched: true };
+  } catch {
+    // Fall through to tier 3
+  }
+
+  // Tier 3: pristine-iframe prototype
+  try {
+    const iframeProto = getPristineInputPrototype();
+    if (iframeProto && iframeProto.set) {
+      iframeProto.set.call(input, value);
+      dispatchEvents(input);
+      return { outcome: "iframe", element: input, value, eventsDispatched: true };
+    }
+  } catch {
+    // Total failure
+  }
+
+  return { outcome: "failed", element: input, value, eventsDispatched: false };
+}
+
+function setTextAreaValue(textarea: HTMLTextAreaElement, value: string): SetResult {
+  // Same tiered approach as input
+  try {
+    const proto = HTMLTextAreaElement.prototype;
+    const descriptor = Object.getOwnPropertyDescriptor(proto, "value");
+    if (descriptor && descriptor.set) {
+      descriptor.set.call(textarea, value);
+      dispatchEvents(textarea);
+      return { outcome: "prototype", element: textarea, value, eventsDispatched: true };
+    }
+  } catch { /* fall through */ }
+
+  try {
+    textarea.value = value;
+    dispatchEvents(textarea);
+    return { outcome: "plain", element: textarea, value, eventsDispatched: true };
+  } catch { /* fall through */ }
+
+  try {
+    const iframeProto = getPristineTextareaPrototype();
+    if (iframeProto && iframeProto.set) {
+      iframeProto.set.call(textarea, value);
+      dispatchEvents(textarea);
+      return { outcome: "iframe", element: textarea, value, eventsDispatched: true };
+    }
+  } catch { /* total failure */ }
+
+  return { outcome: "failed", element: textarea, value, eventsDispatched: false };
+}
+
+function setSelectValue(select: HTMLSelectElement, value: string): SetResult {
+  // Selects don't have the React value-tracker issue because they fire
+  // change events natively. We just set .value and dispatch change.
+  try {
+    // Try exact match first
+    select.value = value;
+    // If no exact match, try case-insensitive match
+    if (select.value !== value) {
+      const lowerValue = value.toLowerCase();
+      for (const opt of Array.from(select.options)) {
+        if (opt.value.toLowerCase() === lowerValue || opt.text.toLowerCase() === lowerValue) {
+          select.value = opt.value;
+          break;
+        }
+      }
+    }
+    dispatchEvents(select);
+    return { outcome: "select", element: select, value: select.value, eventsDispatched: true };
+  } catch {
+    return { outcome: "failed", element: select, value, eventsDispatched: false };
+  }
+}
+
+function setCheckboxValue(input: HTMLInputElement, value: string): SetResult {
+  try {
+    input.checked = value === "true" || value === "on" || value === "1" || value === "yes";
+    dispatchEvents(input);
+    return { outcome: "prototype", element: input, value: String(input.checked), eventsDispatched: true };
+  } catch {
+    return { outcome: "failed", element: input, value, eventsDispatched: false };
+  }
+}
+
+/**
+ * Dispatch the input + change event pair (Card 5 §7.4).
+ *
+ * Both events:
+ *   - bubbles: true      (so they propagate up to document)
+ *   - composed: true     (so they cross shadow DOM boundaries)
+ *
+ * Input event specifically:
+ *   - inputType: 'insertReplacementText' (per spec, NOT 'insertFromPaste')
+ *   - bubbles + composed
+ */
+function dispatchEvents(el: Element): void {
+  // Event 1: input
+  const inputEvent = new InputEvent("input", {
+    bubbles: true,
+    composed: true,
+    // inputType is a valid InputEventInit field but TypeScript's lib may
+    // not always include it. We cast through unknown to bypass.
+    ...({ inputType: "insertReplacementText", data: (el as HTMLInputElement).value }) as unknown as InputEventInit,
+  });
+  el.dispatchEvent(inputEvent);
+
+  // Event 2: change
+  const changeEvent = new Event("change", {
+    bubbles: true,
+    composed: true,
+  });
+  el.dispatchEvent(changeEvent);
+}
+
+// ── Pristine-iframe prototype cache ────────────────────────────────────────
+//
+// Per Card 5 §7.4: "Blank iframes get a fully independent set of global
+// constructors synchronously on attach, which is the standard technique for
+// recovering an unpatched native reference."
+//
+// We create a hidden same-origin about:blank iframe once and cache its
+// HTMLInputElement.prototype value descriptor. If the host page has
+// replaced the main document's prototype, the iframe's is untouched.
+
+let cachedInputDescriptor: PropertyDescriptor | null = null;
+let cachedTextareaDescriptor: PropertyDescriptor | null = null;
+let cachedIframe: HTMLIFrameElement | null = null;
+
+function getPristineInputPrototype(): PropertyDescriptor | null {
+  if (cachedInputDescriptor) return cachedInputDescriptor;
+  const win = getPristineWindow();
+  if (!win) return null;
+  const InputCtor = (win as unknown as { HTMLInputElement: typeof HTMLInputElement }).HTMLInputElement;
+  const descriptor = Object.getOwnPropertyDescriptor(InputCtor.prototype, "value");
+  if (descriptor && descriptor.set) {
+    cachedInputDescriptor = descriptor;
+    return descriptor;
+  }
+  return null;
+}
+
+function getPristineTextareaPrototype(): PropertyDescriptor | null {
+  if (cachedTextareaDescriptor) return cachedTextareaDescriptor;
+  const win = getPristineWindow();
+  if (!win) return null;
+  const TextareaCtor = (win as unknown as { HTMLTextAreaElement: typeof HTMLTextAreaElement }).HTMLTextAreaElement;
+  const descriptor = Object.getOwnPropertyDescriptor(TextareaCtor.prototype, "value");
+  if (descriptor && descriptor.set) {
+    cachedTextareaDescriptor = descriptor;
+    return descriptor;
+  }
+  return null;
+}
+
+function getPristineWindow(): Window | null {
+  if (cachedIframe && cachedIframe.contentWindow) {
+    return cachedIframe.contentWindow;
+  }
+  try {
+    cachedIframe = document.createElement("iframe");
+    cachedIframe.style.display = "none";
+    cachedIframe.setAttribute("aria-hidden", "true");
+    cachedIframe.src = "about:blank";
+    document.documentElement.appendChild(cachedIframe);
+    // about:blank iframes get a fully initialized window synchronously
+    if (cachedIframe.contentWindow) {
+      return cachedIframe.contentWindow;
+    }
+  } catch {
+    cachedIframe = null;
+  }
+  return null;
+}
+
+/**
+ * Tear down the pristine-iframe cache. Called by tests to ensure clean
+ * state across runs.
+ */
+export function teardownPristineIframe(): void {
+  if (cachedIframe) {
+    try { cachedIframe.remove(); } catch { /* ignore */ }
+    cachedIframe = null;
+    cachedInputDescriptor = null;
+    cachedTextareaDescriptor = null;
+  }
+}
diff --git a/packages/adapter-fill-extension/src/matching/hungarian-solver.ts b/packages/adapter-fill-extension/src/matching/hungarian-solver.ts
new file mode 100644
index 0000000..e56e685
--- /dev/null
+++ b/packages/adapter-fill-extension/src/matching/hungarian-solver.ts
@@ -0,0 +1,224 @@
+// =============================================================================
+// Kuhn-Munkres (Hungarian) solver — maximum-weight bipartite matching
+// =============================================================================
+// Per Card 5 §7.3: "builds a cost matrix where rows are form fields and
+// columns are candidate profile keys. Each cell's score is computed by the
+// signal scorer. The matrix is then solved by the Kuhn-Munkres algorithm
+// for maximum-weight bipartite matching."
+//
+// Critical correctness property (Card 5 §7.3):
+//   "Because every non-candidate cell (a genuine 'field X has nothing to do
+//    with key Y', or pure structural padding) costs exactly the same, total
+//    cost over any perfect matching always decomposes as (matrix size) ×
+//    (sentinel) − (sum of scores used). Minimizing that is identical to
+//    maximizing total matched score, so a field with a genuine candidate
+//    is never displaced by one that lacks one."
+//
+// Implementation notes:
+//   - We solve MIN-cost by negating the score (cost = max_score - score)
+//   - Padding cells use a uniform sentinel cost = max_score (so they're
+//     equally unattractive and never displace real candidates)
+//   - O(dim³) — fine for forms of tens to low hundreds of fields
+
+import type { ScoredCandidate } from "./scorer.js";
+
+export interface SolverAssignment {
+  fieldIndex: number;
+  key: string;
+  score: number;
+  /** True if this assignment is a real candidate; false if it's sentinel padding. */
+  real: boolean;
+}
+
+export interface SolverResult {
+  /** The matched assignments (one per field, possibly with sentinel padding). */
+  assignments: SolverAssignment[];
+  /** Total score across real assignments only. */
+  totalScore: number;
+  /** Matrix dimensions (rows × cols). */
+  rows: number;
+  cols: number;
+}
+
+/**
+ * A sentinel "no relationship" cost used for padding cells.
+ *
+ * Per Card 5 §7.3: every non-candidate cell costs exactly the same. We use
+ * a value that's larger than any real score (so it's never preferred over a
+ * real candidate) but finite (so the solver's math doesn't break).
+ */
+const SENTINEL_COST = 1000;
+
+/**
+ * Solve the field-to-key assignment as a minimum-cost perfect matching on
+ * a bipartite graph.
+ *
+ * @param candidates List of (fieldIndex, key, score) candidates from the scorer
+ * @param numFields  Total number of form fields (rows)
+ * @param keys       List of all distinct candidate keys (columns)
+ * @returns          SolverResult with one assignment per field
+ */
+export function solveAssignment(
+  candidates: ScoredCandidate[],
+  numFields: number,
+  keys: string[],
+): SolverResult {
+  if (numFields === 0 || keys.length === 0) {
+    return { assignments: [], totalScore: 0, rows: 0, cols: 0 };
+  }
+
+  const numKeys = keys.length;
+  const dim = Math.max(numFields, numKeys);
+
+  // Build a map for quick score lookup: (fieldIndex, key) → score
+  const scoreMap = new Map<string, number>();
+  for (const c of candidates) {
+    const k = `${c.fieldIndex}|${c.key}`;
+    // Collapse duplicates to the best score (Card 5 §7.3 "defensive behaviors")
+    const existing = scoreMap.get(k);
+    if (existing === undefined || c.score > existing) {
+      scoreMap.set(k, c.score);
+    }
+  }
+
+  // Build cost matrix. Cost = max_score - score. Padding cells get SENTINEL_COST.
+  // We use a high enough "max_score" that real scores always produce lower
+  // cost than the sentinel. We use 100 as the practical max (since scorer
+  // returns values typically in 0-150 range).
+  const PRACTICAL_MAX_SCORE = 200;
+  const costMatrix: number[][] = Array.from({ length: dim }, () =>
+    new Array<number>(dim).fill(SENTINEL_COST),
+  );
+  for (let r = 0; r < dim; r++) {
+    for (let c = 0; c < dim; c++) {
+      if (r < numFields && c < numKeys) {
+        const score = scoreMap.get(`${r}|${keys[c]!}`) ?? 0;
+        // Card 5 §7.3: "non-finite scores (NaN, Infinity) are dropped before
+        // matrix construction". A score of 0 (below LOW_THRESHOLD, filtered
+        // by the scorer) is treated as a non-candidate → sentinel cost.
+        if (score > 0 && Number.isFinite(score)) {
+          costMatrix[r]![c] = PRACTICAL_MAX_SCORE - score;
+        }
+        // Else: SENTINEL_COST (already initialized)
+      }
+    }
+  }
+
+  // Solve minimum-cost perfect matching via Kuhn-Munkres
+  const assignment = hungarian(costMatrix);
+
+  // Convert to SolverAssignment[]
+  const out: SolverAssignment[] = [];
+  let totalScore = 0;
+  for (let r = 0; r < numFields; r++) {
+    const c = assignment[r]!;
+    if (c < numKeys) {
+      const score = scoreMap.get(`${r}|${keys[c]!}`) ?? 0;
+      const real = score > 0 && Number.isFinite(score);
+      out.push({
+        fieldIndex: r,
+        key: keys[c]!,
+        score,
+        real,
+      });
+      if (real) totalScore += score;
+    } else {
+      // Sentinel — field has no real candidate
+      out.push({
+        fieldIndex: r,
+        key: "",
+        score: 0,
+        real: false,
+      });
+    }
+  }
+
+  return {
+    assignments: out,
+    totalScore,
+    rows: numFields,
+    cols: numKeys,
+  };
+}
+
+/**
+ * Kuhn-Munkres (Hungarian) algorithm — minimum-cost perfect matching.
+ *
+ * Standard O(n³) implementation using the potential method. Returns an
+ * array `result` where `result[row] = col` is the assigned column for each
+ * row.
+ *
+ * Reference: Bourgeois' / Jonker-Volgenant-style O(n³) variant. We use the
+ * simpler Jonker-Volgenant formulation that's well-known to be correct.
+ *
+ * Cost matrix must be square. Non-square matrices should be padded by the
+ * caller (we pad above with SENTINEL_COST).
+ */
+function hungarian(cost: number[][]): number[] {
+  const n = cost.length;
+  if (n === 0) return [];
+
+  // Edge case: 1×1 matrix
+  if (n === 1) return [0];
+
+  // Initialize potentials
+  const u = new Array<number>(n + 1).fill(0);
+  const v = new Array<number>(n + 1).fill(0);
+  const p = new Array<number>(n + 1).fill(0);  // p[col] = row assigned to col
+  const way = new Array<number>(n + 1).fill(0);
+
+  for (let row = 1; row <= n; row++) {
+    p[0] = row;
+    let j0 = 0;
+    const minv = new Array<number>(n + 1).fill(Infinity);
+    const used = new Array<boolean>(n + 1).fill(false);
+
+    do {
+      used[j0] = true;
+      const i0 = p[j0]!;
+      let delta = Infinity;
+      let j1 = -1;
+
+      for (let j = 1; j <= n; j++) {
+        if (!used[j]) {
+          const cur = cost[i0 - 1]![j - 1]! - u[i0]! - v[j]!;
+          if (cur < minv[j]!) {
+            minv[j] = cur;
+            way[j] = j0;
+          }
+          if (minv[j]! < delta) {
+            delta = minv[j]!;
+            j1 = j;
+          }
+        }
+      }
+
+      for (let j = 0; j <= n; j++) {
+        if (used[j]) {
+          const pVal = p[j]!;
+          u[pVal] = (u[pVal] ?? 0) + delta;
+          v[j] = (v[j] ?? 0) - delta;
+        } else {
+          minv[j] = (minv[j] ?? 0) - delta;
+        }
+      }
+
+      j0 = j1!;
+    } while (p[j0] !== 0);
+
+    do {
+      const j1 = way[j0]!;
+      p[j0] = p[j1]!;
+      j0 = j1;
+    } while (j0 !== 0);
+  }
+
+  // Convert: result[row-1] = col-1
+  const result = new Array<number>(n).fill(-1);
+  for (let j = 1; j <= n; j++) {
+    if (p[j] !== 0) {
+      result[p[j]! - 1] = j - 1;
+    }
+  }
+  return result;
+}
diff --git a/packages/adapter-fill-extension/src/matching/scanner.ts b/packages/adapter-fill-extension/src/matching/scanner.ts
new file mode 100644
index 0000000..00d5e48
--- /dev/null
+++ b/packages/adapter-fill-extension/src/matching/scanner.ts
@@ -0,0 +1,220 @@
+// =============================================================================
+// Scanner — DOM walker that extracts FieldSignals from form fields
+// =============================================================================
+// Per Card 5 §7.1: "recursively walks the active DOM subtree (including
+// same-origin iframes) and detects all input, select, textarea, and
+// combobox elements. For each, it extracts five signals (label, placeholder,
+// name, id, legend) and normalizes them by tokenizing against an abbreviation
+// dictionary."
+//
+// Output: FieldSignals[] — one per detected form field.
+//
+// Browser-only. This module MUST be importable from the content script.
+// It accesses `document` directly. In tests, we pass a mock document.
+//
+// IMPORTANT: this scanner never writes to the DOM. It only reads. Writes
+// happen in the Framework Setter (native-setter.ts).
+
+import { tokenize, type TokenizerResult } from "./tokenizer.js";
+
+export type FieldType = "text" | "email" | "tel" | "number" | "date" | "datetime-local" | "password" | "url" | "search" | "select-one" | "select-multiple" | "textarea" | "checkbox" | "radio" | "unknown";
+
+export interface FieldSignals {
+  /** Stable identifier for debugging — typically element's id or a synthetic index. */
+  debugId: string;
+  /** The five raw signal sources, as captured from the DOM. */
+  raw: {
+    label: string | null;
+    placeholder: string | null;
+    name: string | null;
+    id: string | null;
+    legend: string | null;
+  };
+  /** Tokenized + normalized versions of each signal. */
+  normalized: {
+    label: TokenizerResult;
+    placeholder: TokenizerResult;
+    name: TokenizerResult;
+    id: TokenizerResult;
+    legend: TokenizerResult;
+  };
+  /** HTML autocomplete attribute value (e.g. "given-name", "email"). */
+  autocomplete: string | null;
+  /** Input type attribute. null means no type attr (defaults to "text"). */
+  type: FieldType;
+  /** Tag name in lowercase ("input", "select", "textarea"). */
+  tagName: string;
+  /** Block type for repeated blocks (e.g. "guest", "address"). null if not in a block. */
+  blockType: string | null;
+  /** Index within the block (0-based). null if not in a block. */
+  blockIndex: number | null;
+  /** The live element reference — kept so the setter can write to it later. */
+  element: Element;
+}
+
+/**
+ * Walk the DOM subtree under `root` and collect form fields.
+ *
+ * Same-origin iframes are walked recursively (per Card 5 §7.1). Cross-origin
+ * iframes are skipped — they're invisible to the content script and would
+ * need their own content script injection.
+ *
+ * @param root The root element to walk. Default: document.body.
+ * @param visited Set of roots already walked (used to prevent infinite loops).
+ *                Callers usually don't pass this; it's for recursion.
+ */
+export function scanDocument(root: Element | Document = document.body, visited: Set<Element> = new Set()): FieldSignals[] {
+  const out: FieldSignals[] = [];
+  if (!root) return out;
+
+  const startEl = root instanceof Document ? root.body : root;
+  if (!startEl || visited.has(startEl)) return out;
+  visited.add(startEl);
+
+  // Query for form fields. We exclude input[type="hidden"], input[type="submit"],
+  // input[type="button"], and input[type="image"] because they're not user-
+  // editable and don't make sense to fill.
+  const selector = "input:not([type='hidden']):not([type='submit']):not([type='button']):not([type='image']):not([type='reset']):not([type='file']):not([type='color']):not([type='range']), select, textarea";
+  const elements = startEl.querySelectorAll(selector);
+
+  elements.forEach((el, idx) => {
+    const signals = extractSignals(el, idx);
+    if (signals) out.push(signals);
+  });
+
+  // Recurse into same-origin iframes
+  startEl.querySelectorAll("iframe").forEach((iframe) => {
+    let innerDoc: Document | null = null;
+    try {
+      // contentDocument throws on cross-origin iframes; we catch and skip.
+      innerDoc = (iframe as HTMLIFrameElement).contentDocument;
+    } catch {
+      // Cross-origin — skip silently per Card 5 §7.1.
+    }
+    if (innerDoc && innerDoc.body) {
+      out.push(...scanDocument(innerDoc.body, visited));
+    }
+  });
+
+  return out;
+}
+
+/**
+ * Extract the 5 signals from a single form element.
+ *
+ * Signal sources, per Card 5 §7.2:
+ *   - label: closest <label for="elementId"> OR wrapping <label>
+ *   - placeholder: element.placeholder
+ *   - name: element.name (form-control name attribute)
+ *   - id: element.id
+ *   - legend: closest <fieldset><legend> for grouped fields
+ */
+function extractSignals(el: Element, idx: number): FieldSignals | null {
+  const tagName = el.tagName.toLowerCase();
+  if (tagName !== "input" && tagName !== "select" && tagName !== "textarea") return null;
+
+  const input = el as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
+
+  // 1. label: look for <label for="id"> first, then wrapping <label>
+  let label: string | null = null;
+  const id = (input as HTMLInputElement).id || null;
+  if (id) {
+    const forLabel = document.querySelector(`label[for="${cssEscape(id)}"]`);
+    if (forLabel) label = forLabel.textContent?.trim() ?? null;
+  }
+  if (!label) {
+    const wrapping = el.closest("label");
+    if (wrapping) label = wrapping.textContent?.trim() ?? null;
+  }
+  // aria-label fallback (covers custom UIs)
+  if (!label) {
+    const ariaLabel = el.getAttribute("aria-label");
+    if (ariaLabel) label = ariaLabel.trim();
+  }
+  // aria-labelledby fallback
+  if (!label) {
+    const labelledBy = el.getAttribute("aria-labelledby");
+    if (labelledBy) {
+      const refs = labelledBy.split(/\s+/).map((id) => document.getElementById(id)).filter(Boolean);
+      const text = refs.map((r) => r?.textContent?.trim() ?? "").join(" ").trim();
+      if (text) label = text;
+    }
+  }
+
+  // 2. placeholder
+  const placeholder = ("placeholder" in input ? input.placeholder : null) || null;
+
+  // 3. name
+  const name = ("name" in input ? input.name : null) || null;
+
+  // 5. legend — closest <fieldset> ancestor's <legend>
+  let legend: string | null = null;
+  const fieldset = el.closest("fieldset");
+  if (fieldset) {
+    const legendEl = fieldset.querySelector("legend");
+    if (legendEl) legend = legendEl.textContent?.trim() ?? null;
+  }
+
+  // autocomplete attribute
+  const autocompleteAttr = el.getAttribute("autocomplete");
+  const autocomplete = autocompleteAttr && autocompleteAttr !== "off" ? autocompleteAttr : null;
+
+  // type — null means "no type attr" (browser defaults to "text")
+  const typeAttr = tagName === "input" ? (input as HTMLInputElement).type.toLowerCase() : tagName;
+  const type = coerceType(typeAttr);
+
+  // block context — look for an ancestor with [data-block-type] or a class
+  // hint like "block-guest" / "block-address". v1: simple heuristic.
+  const blockEl = el.closest("[data-block-type], [class*='block-']");
+  let blockType: string | null = null;
+  let blockIndex: number | null = null;
+  if (blockEl) {
+    blockType = blockEl.getAttribute("data-block-type");
+    if (!blockType) {
+      // Extract from class — e.g. "block-guest-0" → ("guest", 0)
+      const m = (blockEl.className || "").match(/block-([a-z]+)(?:-(\d+))?/);
+      if (m) {
+        blockType = m[1]!;
+        if (m[2]) blockIndex = parseInt(m[2], 10);
+      }
+    } else {
+      const idxAttr = blockEl.getAttribute("data-block-index");
+      if (idxAttr !== null) blockIndex = parseInt(idxAttr, 10);
+    }
+  }
+
+  return {
+    debugId: id ?? `${tagName}-${idx}`,
+    raw: { label, placeholder, name, id, legend },
+    normalized: {
+      label: tokenize(label),
+      placeholder: tokenize(placeholder),
+      name: tokenize(name),
+      id: tokenize(id),
+      legend: tokenize(legend),
+    },
+    autocomplete,
+    type,
+    tagName,
+    blockType,
+    blockIndex,
+    element: el,
+  };
+}
+
+/** Coerce the input.type attribute to a known FieldType. Unknown → "unknown". */
+function coerceType(raw: string): FieldType {
+  const known: FieldType[] = [
+    "text", "email", "tel", "number", "date", "datetime-local", "password",
+    "url", "search", "select-one", "select-multiple", "textarea", "checkbox", "radio",
+  ];
+  return (known as string[]).includes(raw) ? (raw as FieldType) : "unknown";
+}
+
+/** CSS.escape polyfill — used for querySelector(`label[for="${id}"]`). */
+function cssEscape(s: string): string {
+  // Modern browsers ship CSS.escape; older ones don't. For our purposes a
+  // simple backslash-escape of special chars is enough.
+  if (typeof CSS !== "undefined" && typeof CSS.escape === "function") return CSS.escape(s);
+  return s.replace(/["\\]/g, "\\$&");
+}
diff --git a/packages/adapter-fill-extension/src/matching/scorer.ts b/packages/adapter-fill-extension/src/matching/scorer.ts
new file mode 100644
index 0000000..b2f8618
--- /dev/null
+++ b/packages/adapter-fill-extension/src/matching/scorer.ts
@@ -0,0 +1,229 @@
+// =============================================================================
+// Scorer — Card 5 §7.2 scoring formula
+// =============================================================================
+// For each (form field, candidate profile key) pair, computes a score based on:
+//   - Exact phrase match (lowercase, after tokenization): +35 points
+//   - Regex pattern match: +20 points
+//   - Fuzzy similarity (max Dice + Jaro-Winkler) × 15 if > 0.6
+//   - Negative pattern match: −40 points
+//   - Autocomplete token match (HTML autocomplete attribute matches a
+//     rule.autocompleteTokens entry): +45 points (applied once, not per source)
+//   - Block context bonus (field is in a repeated block whose type matches
+//     the rule's expected block type): +15 points (applied once)
+//
+// Source weights (Card 5 §7.2 Table 15):
+//   label       1.0
+//   placeholder 0.9
+//   name        0.8
+//   id          0.7
+//   legend      0.6
+// Take the max across sources.
+//
+// LOW_THRESHOLD and HIGH_THRESHOLD (Card 5 §7.2) control confirmation flow:
+//   - score < LOW_THRESHOLD: candidate is excluded from the cost matrix
+//   - LOW_THRESHOLD ≤ score < HIGH_THRESHOLD: highlight amber, wait for click
+//   - score ≥ HIGH_THRESHOLD: fill silently
+
+import type { FieldSignals } from "./scanner.js";
+import { maxFuzzySimilarity } from "./similarity.js";
+
+export interface Rule {
+  exactPhrases: string[];
+  regexPatterns: string[];
+  autocompleteTokens: string[];
+  allowedTypes?: string[] | null;
+  negativePatterns?: string[];
+  sensitivityTier?: "standard" | "sensitive" | "critical";
+  requiresOptIn?: boolean;
+  optInKey?: string;
+  expectedBlockType?: string;
+}
+
+export type Rules = Record<string, Rule>;
+
+export const LOW_THRESHOLD = 30;
+export const HIGH_THRESHOLD = 60;
+
+export interface ScoredCandidate {
+  fieldIndex: number;
+  key: string;
+  score: number;
+  /** Whether the score is high enough to fill without confirmation. */
+  highConfidence: boolean;
+  /** Whether the score is above LOW_THRESHOLD but below HIGH_THRESHOLD. */
+  needsConfirmation: boolean;
+}
+
+/**
+ * Score a single (field, key) pair.
+ *
+ * The score is computed across all 5 sources, weighted per Card 5 §7.2.
+ * The autocomplete and block-context bonuses are applied once (not per source)
+ * because they're field-level properties, not source-level.
+ */
+export function scorePair(field: FieldSignals, key: string, rule: Rule): number {
+  // ── Field-level bonuses (applied once) ─────────────────────────────────
+  let bonus = 0;
+  if (field.autocomplete && rule.autocompleteTokens.includes(field.autocomplete)) {
+    bonus += 45;  // Card 5 §7.2: autocomplete +45
+  }
+  if (field.blockType && rule.expectedBlockType && field.blockType === rule.expectedBlockType) {
+    bonus += 15;  // Card 5 §7.2: block context +15
+  }
+
+  // ── Per-source scoring (take max) ──────────────────────────────────────
+  const sources: Array<{ signal: typeof field.raw[keyof typeof field.raw]; weight: number; normalized: { phrase: string; tokens: string[] } }> = [
+    { signal: field.raw.label, weight: 1.0, normalized: field.normalized.label },
+    { signal: field.raw.placeholder, weight: 0.9, normalized: field.normalized.placeholder },
+    { signal: field.raw.name, weight: 0.8, normalized: field.normalized.name },
+    { signal: field.raw.id, weight: 0.7, normalized: field.normalized.id },
+    { signal: field.raw.legend, weight: 0.6, normalized: field.normalized.legend },
+  ];
+
+  let maxSourceScore = 0;
+  for (const src of sources) {
+    const sub = scoreSource(src.normalized, rule, src.weight);
+    if (sub > maxSourceScore) maxSourceScore = sub;
+  }
+
+  // ── Negative patterns (applied per source) ─────────────────────────────
+  // Card 5 §7.2: negative patterns disqualify the field. We apply the
+  // −40 penalty if ANY negative pattern matches ANY non-empty source.
+  let penalty = 0;
+  if (rule.negativePatterns && rule.negativePatterns.length > 0) {
+    for (const src of sources) {
+      if (!src.signal) continue;
+      const text = String(src.signal).toLowerCase();
+      for (const pattern of rule.negativePatterns) {
+        try {
+          const re = new RegExp(pattern, "i");
+          if (re.test(text)) {
+            penalty = -40;
+            break;
+          }
+        } catch {
+          // Malformed regex — skip silently
+        }
+      }
+      if (penalty === -40) break;
+    }
+  }
+
+  return maxSourceScore + bonus + penalty;
+}
+
+/**
+ * Score a single source against a rule.
+ *
+ * Returns the sub-score (before bonus and penalty). Sub-score is computed as:
+ *   - Exact phrase match: +35 (then × source weight)
+ *   - Regex pattern match: +20 (then × source weight)
+ *   - Fuzzy similarity (max Dice + Jaro-Winkler) > 0.6: +similarity × 15
+ *     (then × source weight)
+ *
+ * Per Card 5 §7.2: components are SUMMED within a source, then the source
+ * sub-score is multiplied by the source weight. Take max across sources.
+ */
+function scoreSource(
+  normalized: { phrase: string; tokens: string[] },
+  rule: Rule,
+  weight: number,
+): number {
+  if (normalized.phrase.length === 0) return 0;
+
+  let sub = 0;
+
+  // 1. Exact phrase match (lowercase, after tokenization): +35
+  // Card 5 §7.2: "lowercase literal strings; +35 points if any matches the
+  // tokenized source". The rule's exactPhrases are already lowercase literal
+  // strings. We compare against the tokenized source's normalized phrase.
+  // A match means the rule's phrase is a substring of the normalized source
+  // phrase (or vice versa) — but we also do an exact equality check first
+  // because that's the strictest interpretation.
+  for (const phrase of rule.exactPhrases) {
+    const p = phrase.toLowerCase().trim();
+    if (p.length === 0) continue;
+    // Strict equality
+    if (normalized.phrase === p) {
+      sub += 35;
+      break;
+    }
+    // Substring containment (covers "First Name:" label → "first name")
+    if (normalized.phrase.includes(p) || p.includes(normalized.phrase)) {
+      sub += 35;
+      break;
+    }
+    // Token-set containment (covers "Name First" → "first name")
+    const phraseTokens = p.split(/\s+/).filter((t) => t.length > 0);
+    if (phraseTokens.length > 0 && phraseTokens.every((t) => normalized.tokens.includes(t))) {
+      sub += 35;
+      break;
+    }
+  }
+
+  // 2. Regex pattern match: +20
+  for (const pattern of rule.regexPatterns) {
+    try {
+      const re = new RegExp(pattern, "i");
+      if (re.test(normalized.phrase)) {
+        sub += 20;
+        break;
+      }
+    } catch {
+      // Malformed regex — skip silently
+    }
+  }
+
+  // 3. Fuzzy similarity × 15 if max similarity > 0.6
+  let maxSim = 0;
+  for (const phrase of rule.exactPhrases) {
+    const p = phrase.toLowerCase().trim();
+    if (p.length === 0) continue;
+    const sim = maxFuzzySimilarity(normalized.phrase, p);
+    if (sim > maxSim) maxSim = sim;
+  }
+  if (maxSim > 0.6) {
+    sub += maxSim * 15;
+  }
+
+  return sub * weight;
+}
+
+/**
+ * Score all (field, key) pairs.
+ *
+ * Returns a list of ScoredCandidate objects, one per (field, key) pair where
+ * the score is above LOW_THRESHOLD. Candidates below LOW_THRESHOLD are
+ * excluded per Card 5 §7.2.
+ *
+ * @param fields  The scanned form fields
+ * @param rules   The rules dictionary (key → rule)
+ * @returns       List of scored candidates above LOW_THRESHOLD
+ */
+export function scoreAllPairs(fields: FieldSignals[], rules: Rules): ScoredCandidate[] {
+  const out: ScoredCandidate[] = [];
+  for (let i = 0; i < fields.length; i++) {
+    const field = fields[i]!;
+    for (const [key, rule] of Object.entries(rules)) {
+      // Type guard: skip if rule.allowsTypes is set and the field's type
+      // is not in the allowed list. null type means "any".
+      if (rule.allowedTypes && rule.allowedTypes.length > 0) {
+        const allowed = rule.allowedTypes.filter((t) => t !== null) as string[];
+        if (allowed.length > 0 && !allowed.includes(field.type)) {
+          continue;
+        }
+      }
+      const score = scorePair(field, key, rule);
+      if (score >= LOW_THRESHOLD) {
+        out.push({
+          fieldIndex: i,
+          key,
+          score: Math.round(score * 100) / 100,
+          highConfidence: score >= HIGH_THRESHOLD,
+          needsConfirmation: score >= LOW_THRESHOLD && score < HIGH_THRESHOLD,
+        });
+      }
+    }
+  }
+  return out;
+}
diff --git a/packages/adapter-fill-extension/src/matching/similarity.ts b/packages/adapter-fill-extension/src/matching/similarity.ts
new file mode 100644
index 0000000..5396fb9
--- /dev/null
+++ b/packages/adapter-fill-extension/src/matching/similarity.ts
@@ -0,0 +1,115 @@
+// =============================================================================
+// Fuzzy similarity — Dice coefficient + Jaro-Winkler
+// =============================================================================
+// Per Card 5 §7.2: "Fuzzy similarity (max of Dice coefficient and
+// Jaro-Winkler, against every exact phrase in the rule): if > 0.6,
+// +max_similarity × 15 points"
+//
+// Both algorithms return a similarity score in [0, 1]. We take the MAX of
+// the two (per the spec) so that Dice catches token-level similarity and
+// Jaro-Winkler catches character-level similarity with prefix preference.
+
+/**
+ * Dice coefficient (Sørensen–Dice) on bigrams.
+ *
+ * For two strings, builds the set of character bigrams for each, then
+ * computes 2 × |intersection| / (|A| + |B|).
+ *
+ * Examples:
+ *   dice("first name", "first name") → 1.0
+ *   dice("first name", "firstname")  → ~0.78 (tokenization done elsewhere)
+ *   dice("email", "mail")            → ~0.33
+ */
+export function diceCoefficient(a: string, b: string): number {
+  if (a === b && a.length > 0) return 1.0;
+  if (a.length < 2 || b.length < 2) return 0.0;
+  const bigramsA = bigrams(a);
+  const bigramsB = bigrams(b);
+  if (bigramsA.size === 0 || bigramsB.size === 0) return 0.0;
+
+  let intersection = 0;
+  for (const bg of bigramsA) {
+    if (bigramsB.has(bg)) intersection++;
+  }
+  return (2 * intersection) / (bigramsA.size + bigramsB.size);
+}
+
+function bigrams(s: string): Set<string> {
+  const out = new Set<string>();
+  for (let i = 0; i < s.length - 1; i++) {
+    out.add(s.slice(i, i + 2));
+  }
+  return out;
+}
+
+/**
+ * Jaro-Winkler similarity.
+ *
+ * Standard implementation. Prefix-scaling factor p = 0.1, max prefix len = 4
+ * (Winkler's defaults). Returns a value in [0, 1].
+ *
+ * Examples:
+ *   jaroWinkler("first name", "first name") → 1.0
+ *   jaroWinkler("martha", "marhta")          → ~0.961 (classic example)
+ *   jaroWinkler("email", "phone")            → 0.0
+ */
+export function jaroWinkler(s1: string, s2: string): number {
+  if (s1.length === 0 || s2.length === 0) return 0.0;
+  if (s1 === s2) return 1.0;
+
+  const j = jaro(s1, s2);
+  // Common prefix length, up to 4
+  let prefixLen = 0;
+  while (prefixLen < 4 && s1[prefixLen] === s2[prefixLen]) prefixLen++;
+  return j + prefixLen * 0.1 * (1 - j);
+}
+
+function jaro(s1: string, s2: string): number {
+  const len1 = s1.length;
+  const len2 = s2.length;
+  if (len1 === 0 || len2 === 0) return 0.0;
+  if (s1 === s2) return 1.0;
+
+  const matchDistance = Math.floor(Math.max(len1, len2) / 2) - 1;
+  const s1Matches = new Array<boolean>(len1).fill(false);
+  const s2Matches = new Array<boolean>(len2).fill(false);
+  let matches = 0;
+
+  for (let i = 0; i < len1; i++) {
+    const start = Math.max(0, i - matchDistance);
+    const end = Math.min(i + matchDistance + 1, len2);
+    for (let j = start; j < end; j++) {
+      if (s2Matches[j]) continue;
+      if (s1[i] !== s2[j]) continue;
+      s1Matches[i] = true;
+      s2Matches[j] = true;
+      matches++;
+      break;
+    }
+  }
+
+  if (matches === 0) return 0.0;
+
+  // Count transpositions
+  let transpositions = 0;
+  let k = 0;
+  for (let i = 0; i < len1; i++) {
+    if (!s1Matches[i]) continue;
+    while (!s2Matches[k]) k++;
+    if (s1[i] !== s2[k]) transpositions++;
+    k++;
+  }
+  transpositions = transpositions / 2;
+
+  return (
+    (matches / len1 + matches / len2 + (matches - transpositions) / matches) / 3
+  );
+}
+
+/**
+ * Take the max of Dice and Jaro-Winkler, per Card 5 §7.2.
+ * Returns a value in [0, 1].
+ */
+export function maxFuzzySimilarity(a: string, b: string): number {
+  return Math.max(diceCoefficient(a, b), jaroWinkler(a, b));
+}
diff --git a/packages/adapter-fill-extension/src/matching/tokenizer.ts b/packages/adapter-fill-extension/src/matching/tokenizer.ts
new file mode 100644
index 0000000..2e1cdf9
--- /dev/null
+++ b/packages/adapter-fill-extension/src/matching/tokenizer.ts
@@ -0,0 +1,97 @@
+// =============================================================================
+// Tokenizer — lowercase + split + abbreviation expansion
+// =============================================================================
+// Per Card 5 §7.1: "For each [field], it extracts five signals (label,
+// placeholder, name, id, legend) and normalizes them by tokenizing against
+// an abbreviation dictionary."
+//
+// The tokenizer is intentionally simple: lowercase, replace non-alphanumeric
+// runs with single spaces, expand known abbreviations, return the token list
+// AND the rejoined normalized phrase. Both forms are used by the scorer:
+//   - token list: fuzzy matching (Dice coefficient needs token sets)
+//   - normalized phrase: exact-phrase comparison
+//
+// No external dependencies — keeps the extension bundle small.
+
+/** Abbreviation dictionary. Keys are lowercase abbreviations; values are
+ *  their expansions. Add hotel-specific terms here. */
+const ABBREVIATIONS: Record<string, string> = {
+  "fn": "first name",
+  "ln": "last name",
+  "fname": "first name",
+  "lname": "last name",
+  "dob": "date of birth",
+  "tel": "telephone",
+  "ph": "phone",
+  "no": "number",
+  "num": "number",
+  "apt": "apartment",
+  "ste": "suite",
+  "bldg": "building",
+  "co": "company",
+  "org": "organization",
+  "addr": "address",
+  "st": "street",
+  "ave": "avenue",
+  "rd": "road",
+  "ct": "city",
+  // 'st' is overloaded — context-dependent. We keep "street" as the
+  // expansion because that's by far the most common usage on registration
+  // forms. The scorer's negative-pattern check disambiguates state vs street
+  // when needed.
+  "zip": "postal code",
+  "pc": "postal code",
+  "postcode": "postal code",
+  "e-mail": "email",
+  "e_mail": "email",
+  "emailaddr": "email address",
+  "phonenum": "phone number",
+  "mobilenum": "mobile number",
+  "dobdate": "date of birth",
+};
+
+export interface TokenizerResult {
+  /** Lowercase, normalized phrase — used for exact-phrase matching. */
+  phrase: string;
+  /** Token list — used for fuzzy matching (Dice, Jaro-Winkler). */
+  tokens: string[];
+}
+
+/**
+ * Tokenize a raw string from a form field signal (label, placeholder, etc.).
+ *
+ * Steps:
+ *   1. Lowercase
+ *   2. Split on any non-alphanumeric run (spaces, dashes, underscores, etc.)
+ *   3. Expand abbreviations using the dictionary above
+ *   4. Re-join with single spaces → normalized phrase
+ *
+ * Returns the phrase (string) and the token list (string[]). Both are
+ * safe to compare across signals because the normalization is deterministic.
+ */
+export function tokenize(raw: string | null | undefined): TokenizerResult {
+  if (raw === null || raw === undefined) return { phrase: "", tokens: [] };
+
+  const lower = String(raw).toLowerCase().trim();
+  if (lower.length === 0) return { phrase: "", tokens: [] };
+
+  // Split on non-alphanumeric runs
+  const rawTokens = lower.split(/[^a-z0-9]+/).filter((t) => t.length > 0);
+
+  // Expand abbreviations inline
+  const expanded: string[] = [];
+  for (const t of rawTokens) {
+    if (ABBREVIATIONS[t]) {
+      // The expansion may itself contain spaces — split again.
+      const sub = ABBREVIATIONS[t].split(/\s+/).filter((s) => s.length > 0);
+      expanded.push(...sub);
+    } else {
+      expanded.push(t);
+    }
+  }
+
+  return {
+    phrase: expanded.join(" "),
+    tokens: expanded,
+  };
+}
diff --git a/packages/adapter-fill-extension/src/messaging/messages.ts b/packages/adapter-fill-extension/src/messaging/messages.ts
new file mode 100644
index 0000000..728cabd
--- /dev/null
+++ b/packages/adapter-fill-extension/src/messaging/messages.ts
@@ -0,0 +1,128 @@
+// =============================================================================
+// Messaging — typed message contracts between popup, background, content script
+// =============================================================================
+// Per Card 5 §7.7: "Receptionist confirmation flow: high-confidence matches
+// fill silently; medium-confidence matches highlight amber and wait for click;
+// nothing below LOW_THRESHOLD fills."
+//
+// Message flow:
+//   1. Receptionist clicks "Fill form" in the popup
+//   2. Popup sends FILL_REQUEST message with the guest profile to the
+//      background service worker
+//   3. Background forwards to the active tab's content script
+//   4. Content script runs fillForm() and returns FillResult
+//   5. Popup displays the summary (filled / needs confirmation)
+//
+// For the workspace UI integration:
+//   - The workspace "Prepare Registration" button stores the guest in
+//     chrome.storage.local and opens the popup (or, if the user is on the
+//     hotel's PMS page, triggers fillForm directly).
+//   - The popup reads the stored guest from chrome.storage.local.
+
+export type MessageType =
+  | "FILL_REQUEST"        // popup → content (via background)
+  | "FILL_RESULT"         // content → popup (via background)
+  | "SCAN_REQUEST"        // popup → content (just scan, no fill)
+  | "SCAN_RESULT"         // content → popup
+  | "GET_STORED_GUEST"    // popup → background
+  | "STORE_GUEST"         // workspace UI → background (via window.postMessage)
+  | "GUEST_STORED";       // background → popup
+
+export interface BaseMessage<T extends MessageType, P = unknown> {
+  type: T;
+  payload: P;
+}
+
+export interface FillRequestMessage extends BaseMessage<"FILL_REQUEST", FillRequestPayload> {}
+export interface FillResultMessage extends BaseMessage<"FILL_RESULT", FillResultPayload> {}
+export interface ScanRequestMessage extends BaseMessage<"SCAN_REQUEST", {}> {}
+export interface ScanResultMessage extends BaseMessage<"SCAN_RESULT", ScanResultPayload> {}
+export interface GetStoredGuestMessage extends BaseMessage<"GET_STORED_GUEST", {}> {}
+export interface StoreGuestMessage extends BaseMessage<"STORE_GUEST", StoreGuestPayload> {}
+export interface GuestStoredMessage extends BaseMessage<"GUEST_STORED", StoreGuestPayload | null> {}
+
+export type Message =
+  | FillRequestMessage
+  | FillResultMessage
+  | ScanRequestMessage
+  | ScanResultMessage
+  | GetStoredGuestMessage
+  | StoreGuestMessage
+  | GuestStoredMessage;
+
+export interface FillRequestPayload {
+  profile: Record<string, unknown>;
+  autoFillHighConfidence?: boolean;
+}
+
+export interface FillResultPayload {
+  totalFields: number;
+  totalCandidates: number;
+  realAssignments: number;
+  highConfidenceFills: number;
+  mediumConfidenceFills: number;
+  durationMs: number;
+  /** Per-assignment details for the popup's "review matches" view. */
+  assignments: Array<{
+    fieldIndex: number;
+    key: string;
+    score: number;
+    real: boolean;
+    highConfidence: boolean;
+    needsConfirmation: boolean;
+    fieldLabel: string | null;
+  }>;
+}
+
+export interface ScanResultPayload {
+  totalFields: number;
+  /** First 5 fields' signals, for the popup's preview. */
+  preview: Array<{
+    debugId: string;
+    type: string;
+    label: string | null;
+    placeholder: string | null;
+    name: string | null;
+    id: string | null;
+  }>;
+}
+
+export interface StoreGuestPayload {
+  guest: {
+    guestId: string;
+    firstName: string | null;
+    lastName: string | null;
+    email: string | null;
+    phone: string | null;
+    dateOfBirth: string | null;
+    nationality: string | null;
+    addressLine1: string | null;
+    addressLine2: string | null;
+    city: string | null;
+    state: string | null;
+    postalCode: string | null;
+    country: string | null;
+    company: string | null;
+    notes: string | null;
+  };
+  /** When the guest was stored (epoch ms). Used for staleness checks. */
+  storedAt: number;
+}
+
+// ── Type guards ────────────────────────────────────────────────────────────
+
+export function isFillRequest(m: unknown): m is FillRequestMessage {
+  return typeof m === "object" && m !== null && (m as BaseMessage<MessageType>).type === "FILL_REQUEST";
+}
+
+export function isScanRequest(m: unknown): m is ScanRequestMessage {
+  return typeof m === "object" && m !== null && (m as BaseMessage<MessageType>).type === "SCAN_REQUEST";
+}
+
+export function isGetStoredGuest(m: unknown): m is GetStoredGuestMessage {
+  return typeof m === "object" && m !== null && (m as BaseMessage<MessageType>).type === "GET_STORED_GUEST";
+}
+
+export function isStoreGuest(m: unknown): m is StoreGuestMessage {
+  return typeof m === "object" && m !== null && (m as BaseMessage<MessageType>).type === "STORE_GUEST";
+}
