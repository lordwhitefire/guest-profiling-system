diff --git a/packages/adapter-fill-extension/scripts/build.mjs b/packages/adapter-fill-extension/scripts/build.mjs
index 9e3c3d5..4835cd6 100644
--- a/packages/adapter-fill-extension/scripts/build.mjs
+++ b/packages/adapter-fill-extension/scripts/build.mjs
@@ -1,3 +1,130 @@
-// Stub build script — TASK-006 will implement esbuild bundling for MV3.
-console.error("[adapter-fill-extension] build not yet implemented. See TASK-006.");
-process.exit(1);
+// =============================================================================
+// Build script — esbuild bundles the extension's TypeScript to MV3-compatible JS
+// =============================================================================
+// Produces 4 bundles in dist/:
+//   - background.js  (service worker, type: module per manifest)
+//   - content.js     (content script, runs in page context)
+//   - popup.js       (popup script, runs in popup.html context)
+//   - popup.html + popup.css are copied as-is
+//
+// Also copies rules/rules.json into dist/rules/ so the content script's
+// dynamic import works at runtime.
+//
+// Run: pnpm --filter @gps/adapter-fill-extension build
+
+import { build, context } from "esbuild";
+import { copyFile, mkdir, rm } from "node:fs/promises";
+import { existsSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const __dirname = dirname(fileURLToPath(import.meta.url));
+const ROOT = join(__dirname, "..");
+const DIST = join(ROOT, "dist");
+const SRC = join(ROOT, "src");
+
+// Production build (no watch)
+async function buildProd() {
+  // Clean dist
+  if (existsSync(DIST)) await rm(DIST, { recursive: true, force: true });
+  await mkdir(DIST, { recursive: true });
+
+  // Build the three JS bundles in parallel
+  await Promise.all([
+    build({
+      entryPoints: [join(SRC, "background/background.ts")],
+      bundle: true,
+      outfile: join(DIST, "background.js"),
+      target: "chrome120",
+      format: "esm",
+      platform: "browser",
+      minify: true,
+      sourcemap: false,
+      logLevel: "info",
+      define: {
+        "process.env.NODE_ENV": '"production"',
+      },
+    }),
+    build({
+      entryPoints: [join(SRC, "content/content.ts")],
+      bundle: true,
+      outfile: join(DIST, "content.js"),
+      target: "chrome120",
+      // Content scripts MUST be IIFE — MV3 doesn't allow modules for them
+      format: "iife",
+      platform: "browser",
+      minify: true,
+      sourcemap: false,
+      logLevel: "info",
+      define: {
+        "process.env.NODE_ENV": '"production"',
+      },
+    }),
+    build({
+      entryPoints: [join(SRC, "popup/popup.ts")],
+      bundle: true,
+      outfile: join(DIST, "popup.js"),
+      target: "chrome120",
+      format: "iife",
+      platform: "browser",
+      minify: true,
+      sourcemap: false,
+      logLevel: "info",
+      define: {
+        "process.env.NODE_ENV": '"production"',
+      },
+    }),
+  ]);
+
+  // Copy static assets
+  await copyFile(join(SRC, "popup/popup.html"), join(DIST, "popup.html"));
+  await copyFile(join(SRC, "popup/popup.css"), join(DIST, "popup.css"));
+  await copyFile(join(ROOT, "manifest.json"), join(DIST, "manifest.json"));
+
+  // Copy rules.json
+  await mkdir(join(DIST, "rules"), { recursive: true });
+  await copyFile(join(ROOT, "rules/rules.json"), join(DIST, "rules/rules.json"));
+
+  console.log("\n[build] Done. Output in dist/:");
+  console.log("  background.js  (service worker)");
+  console.log("  content.js     (content script, IIFE)");
+  console.log("  popup.js       (popup script, IIFE)");
+  console.log("  popup.html + popup.css");
+  console.log("  manifest.json");
+  console.log("  rules/rules.json");
+  console.log("\nLoad as unpacked extension: chrome://extensions → Load unpacked → select dist/");
+}
+
+// Dev build with watch
+async function buildDev() {
+  await buildProd();
+  console.log("\n[dev] Watching for changes...");
+
+  for (const entry of ["background/background.ts", "content/content.ts", "popup/popup.ts"]) {
+    const ctx = await context({
+      entryPoints: [join(SRC, entry)],
+      bundle: true,
+      outfile: join(DIST, entry.replace("background/background", "background").replace("content/content", "content").replace("popup/popup", "popup") + ".js"),
+      target: "chrome120",
+      format: entry.startsWith("content") || entry.startsWith("popup") ? "iife" : "esm",
+      platform: "browser",
+      minify: false,
+      sourcemap: true,
+      logLevel: "info",
+    });
+    await ctx.watch();
+  }
+}
+
+const watch = process.argv.includes("--watch");
+if (watch) {
+  buildDev().catch((err) => {
+    console.error("[build] Failed:", err);
+    process.exit(1);
+  });
+} else {
+  buildProd().catch((err) => {
+    console.error("[build] Failed:", err);
+    process.exit(1);
+  });
+}
diff --git a/packages/adapter-fill-extension/src/background/background.ts b/packages/adapter-fill-extension/src/background/background.ts
new file mode 100644
index 0000000..32b6a0f
--- /dev/null
+++ b/packages/adapter-fill-extension/src/background/background.ts
@@ -0,0 +1,103 @@
+// =============================================================================
+// Background service worker — MV3 service worker
+// =============================================================================
+// Routes messages between the popup and content scripts. Also handles the
+// STORE_GUEST message from the workspace UI (via window.postMessage bridge).
+//
+// Card 5 §7.7 contract:
+//   - Receptionist clicks "Prepare Registration" in the workspace UI
+//   - Workspace UI posts a STORE_GUEST message to the page
+//   - A small injected bridge script picks it up and sends to background
+//   - Background stores in chrome.storage.local
+//   - When the receptionist opens the popup on the hotel's PMS page, the
+//     popup reads the stored guest and shows "Ready to fill: John Doe"
+//   - Receptionist clicks "Fill form" in the popup
+//   - Popup sends FILL_REQUEST to background
+//   - Background forwards to active tab's content script
+//   - Content script runs fillForm() and returns FillResult
+//   - Popup displays the result
+//
+// STORAGE SCHEMA (chrome.storage.local):
+//   - "gps:guest" — the last-stored guest profile (StoreGuestPayload)
+//   - "gps:lastFill" — the last fill result (for debugging / undo)
+
+import {
+  isGetStoredGuest,
+  isFillRequest,
+  type StoreGuestPayload,
+} from "../messaging/messages.js";
+
+const STORAGE_KEY_GUEST = "gps:guest";
+const STORAGE_KEY_LAST_FILL = "gps:lastFill";
+
+chrome.runtime.onInstalled.addListener(() => {
+  console.info("[adapter-fill bg] Extension installed");
+});
+
+chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {
+  // GET_STORED_GUEST: popup → background
+  if (isGetStoredGuest(message)) {
+    chrome.storage.local.get(STORAGE_KEY_GUEST).then((result) => {
+      const guest = result[STORAGE_KEY_GUEST] as StoreGuestPayload | undefined;
+      sendResponse({ type: "GUEST_STORED", payload: guest ?? null });
+    });
+    return true;
+  }
+
+  // FILL_REQUEST: popup → background → content script (active tab)
+  if (isFillRequest(message)) {
+    chrome.tabs.query({ active: true, currentWindow: true }).then(async (tabs) => {
+      const tabId = tabs[0]?.id;
+      if (!tabId) {
+        sendResponse({
+          type: "FILL_RESULT",
+          payload: { error: "No active tab", totalFields: 0, assignments: [] },
+        });
+        return;
+      }
+      try {
+        const response = await chrome.tabs.sendMessage(tabId, message);
+        // Cache the result for debugging
+        if (chrome.storage.local) {
+          chrome.storage.local.set({ [STORAGE_KEY_LAST_FILL]: response });
+        }
+        sendResponse(response);
+      } catch (err) {
+        console.error("[adapter-fill bg] tabs.sendMessage failed:", err);
+        sendResponse({
+          type: "FILL_RESULT",
+          payload: {
+            error: err instanceof Error ? err.message : "Could not reach the active tab. Make sure you're on the hotel's registration page.",
+            totalFields: 0,
+            assignments: [],
+          },
+        });
+      }
+    });
+    return true;
+  }
+
+  // External messages from the workspace UI (via the bridge script)
+  if (typeof message === "object" && message !== null && message.type === "STORE_GUEST") {
+    const payload = (message as { payload: StoreGuestPayload }).payload;
+    chrome.storage.local.set({ [STORAGE_KEY_GUEST]: payload }).then(() => {
+      sendResponse({ type: "GUEST_STORED", payload });
+    });
+    return true;
+  }
+
+  return false;
+});
+
+// Allow external websites (our workspace UI) to send messages to this extension
+// Requires "externally_connectable" in manifest.json
+chrome.runtime.onMessageExternal.addListener((message, _sender, sendResponse) => {
+  if (typeof message === "object" && message !== null && message.type === "STORE_GUEST") {
+    const payload = (message as { payload: StoreGuestPayload }).payload;
+    chrome.storage.local.set({ [STORAGE_KEY_GUEST]: payload }).then(() => {
+      sendResponse({ type: "GUEST_STORED", payload });
+    });
+    return true;
+  }
+  return false;
+});
diff --git a/packages/adapter-fill-extension/src/content/content.ts b/packages/adapter-fill-extension/src/content/content.ts
new file mode 100644
index 0000000..371a0a6
--- /dev/null
+++ b/packages/adapter-fill-extension/src/content/content.ts
@@ -0,0 +1,103 @@
+// =============================================================================
+// Content script — runs on every page (per manifest's content_scripts)
+// =============================================================================
+// Receives FILL_REQUEST and SCAN_REQUEST messages from the popup (via the
+// background service worker), runs the fill pipeline, and returns the result.
+//
+// This script is bundled by esbuild into dist/content.js, which is loaded
+// by Chrome via the manifest's content_scripts entry.
+//
+// Card 5 §7.1: the scanner walks the active DOM subtree (including same-origin
+// iframes). We don't gate on URL — the manifest's host_permissions determine
+// which pages this script runs on. The popup is what the receptionist uses
+// to trigger a fill.
+
+import { fillForm } from "../fill/fill.js";
+import { scanDocument } from "../matching/scanner.js";
+import { LOW_THRESHOLD, HIGH_THRESHOLD } from "../matching/scorer.js";
+import {
+  isFillRequest,
+  isScanRequest,
+  type FillRequestMessage,
+  type FillResultMessage,
+  type ScanResultMessage,
+  type FillResultPayload,
+} from "../messaging/messages.js";
+
+chrome.runtime.onMessage.addListener((message, _sender, sendResponse) => {
+  if (isFillRequest(message)) {
+    handleFillRequest(message).then(sendResponse);
+    return true;  // keep the message channel open for async response
+  }
+  if (isScanRequest(message)) {
+    handleScanRequest().then(sendResponse);
+    return true;
+  }
+  // Unknown message type — ignore (don't return true)
+  return false;
+});
+
+async function handleFillRequest(message: FillRequestMessage): Promise<FillResultMessage> {
+  try {
+    const result = await fillForm({
+      profile: message.payload.profile,
+      autoFillHighConfidence: message.payload.autoFillHighConfidence ?? true,
+    });
+
+    const payload: FillResultPayload = {
+      totalFields: result.totalFields,
+      totalCandidates: result.totalCandidates,
+      realAssignments: result.realAssignments,
+      highConfidenceFills: result.highConfidenceFills,
+      mediumConfidenceFills: result.mediumConfidenceFills,
+      durationMs: result.durationMs,
+      assignments: result.assignments.map((a) => ({
+        fieldIndex: a.fieldIndex,
+        key: a.key,
+        score: a.score,
+        real: a.real,
+        highConfidence: a.score >= HIGH_THRESHOLD,
+        needsConfirmation: a.real && a.score >= LOW_THRESHOLD && a.score < HIGH_THRESHOLD,
+        fieldLabel: result.fields[a.fieldIndex]?.raw.label ?? null,
+      })),
+    };
+
+    return { type: "FILL_RESULT", payload };
+  } catch (err) {
+    console.error("[adapter-fill content] fillForm failed:", err);
+    return {
+      type: "FILL_RESULT",
+      payload: {
+        totalFields: 0,
+        totalCandidates: 0,
+        realAssignments: 0,
+        highConfidenceFills: 0,
+        mediumConfidenceFills: 0,
+        durationMs: 0,
+        assignments: [],
+        error: err instanceof Error ? err.message : "Unknown error",
+      } as FillResultPayload & { error?: string },
+    };
+  }
+}
+
+async function handleScanRequest(): Promise<ScanResultMessage> {
+  const fields = scanDocument(document.body);
+  return {
+    type: "SCAN_RESULT",
+    payload: {
+      totalFields: fields.length,
+      preview: fields.slice(0, 5).map((f) => ({
+        debugId: f.debugId,
+        type: f.type,
+        label: f.raw.label,
+        placeholder: f.raw.placeholder,
+        name: f.raw.name,
+        id: f.raw.id,
+      })),
+    },
+  };
+}
+
+// Export the thresholds for re-use by the popup if it imports from this module
+export { LOW_THRESHOLD, HIGH_THRESHOLD };
diff --git a/packages/adapter-fill-extension/src/fill/fill.ts b/packages/adapter-fill-extension/src/fill/fill.ts
new file mode 100644
index 0000000..68f8eac
--- /dev/null
+++ b/packages/adapter-fill-extension/src/fill/fill.ts
@@ -0,0 +1,142 @@
+// =============================================================================
+// Fill orchestrator — the three-stage pipeline
+// =============================================================================
+// Per Card 5 §7.1: "scan → score → solve → set. No shortcuts."
+//
+// This module ties together:
+//   1. scanner.ts → FieldSignals[]
+//   2. scorer.ts → ScoredCandidate[]
+//   3. hungarian-solver.ts → SolverAssignment[]
+//   4. native-setter.ts → writes to the DOM
+//
+// The orchestrator is the single entry point called by the content script
+// when the receptionist clicks "Fill form" in the popup.
+
+import { scanDocument, type FieldSignals } from "../matching/scanner.js";
+import { scoreAllPairs, type Rules, type Rule, type ScoredCandidate, LOW_THRESHOLD, HIGH_THRESHOLD } from "../matching/scorer.js";
+import { solveAssignment, type SolverAssignment } from "../matching/hungarian-solver.js";
+import { setValue, type SetResult } from "./native-setter.js";
+
+export interface FillRequest {
+  /** The guest profile data, flattened to key → value (e.g. { firstName: "John", ... }). */
+  profile: Record<string, unknown>;
+  /** The rules dictionary (rules.json content). Defaults to the bundled one. */
+  rules?: Rules;
+  /** Whether to fill high-confidence matches silently (true) or always prompt (false). */
+  autoFillHighConfidence?: boolean;
+}
+
+export interface FillResult {
+  /** Total fields scanned. */
+  totalFields: number;
+  /** Total candidates above LOW_THRESHOLD before solving. */
+  totalCandidates: number;
+  /** Total assignments (one per field, possibly with sentinel padding). */
+  totalAssignments: number;
+  /** Real (non-sentinel) assignments. */
+  realAssignments: number;
+  /** High-confidence fills (score >= HIGH_THRESHOLD). */
+  highConfidenceFills: number;
+  /** Medium-confidence fills (LOW_THRESHOLD <= score < HIGH_THRESHOLD). */
+  mediumConfidenceFills: number;
+  /** Results from the native setter. */
+  writeResults: SetResult[];
+  /** Total pipeline duration in milliseconds. */
+  durationMs: number;
+  /** The scanned fields (kept for the popup to display). */
+  fields: FieldSignals[];
+  /** The solved assignments (kept for the popup to display). */
+  assignments: SolverAssignment[];
+  /** The scored candidates above LOW_THRESHOLD. */
+  candidates: ScoredCandidate[];
+}
+
+/**
+ * Run the full three-stage fill pipeline on the current document.
+ *
+ * @returns A summary of what was scanned, scored, solved, and written.
+ *          The popup uses this to display what was filled and what needs
+ *          confirmation.
+ */
+export async function fillForm(req: FillRequest): Promise<FillResult> {
+  const startTime = Date.now();
+
+  // Load rules — either the ones provided, or the bundled default.
+  const rules = req.rules ?? await loadDefaultRules();
+
+  // ── Stage 1: Scan ─────────────────────────────────────────────────────
+  const fields = scanDocument(document.body);
+
+  // ── Stage 2: Score ────────────────────────────────────────────────────
+  const candidates = scoreAllPairs(fields, rules);
+
+  // ── Stage 3: Solve ────────────────────────────────────────────────────
+  const keys = Array.from(new Set(candidates.map((c) => c.key)));
+  const solverResult = solveAssignment(candidates, fields.length, keys);
+
+  // ── Stage 4: Set ──────────────────────────────────────────────────────
+  const writeResults: SetResult[] = [];
+  let highConfidenceFills = 0;
+  let mediumConfidenceFills = 0;
+
+  for (const assignment of solverResult.assignments) {
+    if (!assignment.real) continue;
+    if (assignment.score < LOW_THRESHOLD) continue;
+
+    const value = req.profile[assignment.key];
+    if (value === undefined || value === null) continue;
+
+    const field = fields[assignment.fieldIndex];
+    if (!field) continue;
+
+    const valueStr = String(value);
+    const result = setValue(field.element, valueStr);
+    writeResults.push(result);
+
+    if (assignment.score >= HIGH_THRESHOLD) {
+      highConfidenceFills++;
+    } else {
+      mediumConfidenceFills++;
+    }
+  }
+
+  return {
+    totalFields: fields.length,
+    totalCandidates: candidates.length,
+    totalAssignments: solverResult.assignments.length,
+    realAssignments: solverResult.assignments.filter((a) => a.real).length,
+    highConfidenceFills,
+    mediumConfidenceFills,
+    writeResults,
+    durationMs: Date.now() - startTime,
+    fields,
+    assignments: solverResult.assignments,
+    candidates,
+  };
+}
+
+/**
+ * Load the default rules.json. In the content script, this is bundled by
+ * esbuild via `import rules from "../../rules/rules.json"`. In tests, we
+ * pass the rules directly via FillRequest.rules.
+ */
+async function loadDefaultRules(): Promise<Rules> {
+  // Dynamic import — esbuild bundles JSON imports statically
+  try {
+    const mod = await import("../../rules/rules.json");
+    const raw = mod.default as Record<string, unknown>;
+    // Filter out the "_meta" key (not a rule — it's documentation)
+    const out: Rules = {};
+    for (const [key, value] of Object.entries(raw)) {
+      if (key === "_meta") continue;
+      out[key] = value as Rule;
+    }
+    return out;
+  } catch {
+    console.warn("[adapter-fill] Could not load default rules.json — no rules applied");
+    return {};
+  }
+}
+
+/** Thresholds re-exported for the popup. */
+export { LOW_THRESHOLD, HIGH_THRESHOLD };
diff --git a/packages/adapter-fill-extension/src/fill/native-setter.ts b/packages/adapter-fill-extension/src/fill/native-setter.ts
