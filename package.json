{
  "name": "guest-profiling-system",
  "version": "0.1.0",
  "private": true,
  "description": "Hotel guest profiling system — reads existing guest records (read-only), shows live-filtered matching profiles as a receptionist types, and auto-fills the hotel's existing registration form on click.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @gps/core dev",
    "build": "pnpm -r --filter=!@gps/adapter-fill-extension build",
    "build:extension": "pnpm --filter @gps/adapter-fill-extension build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test:unit": "pnpm -r test:unit",
    "test:e2e": "pnpm --filter @gps/core test:e2e",
    "db:migrate": "pnpm --filter @gps/shared db:migrate",
    "db:rollback": "pnpm --filter @gps/shared db:rollback",
    "db:migrate:create": "pnpm --filter @gps/shared db:migrate:create"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.7"
  }
}
