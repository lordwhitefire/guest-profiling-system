{
  "name": "@gps/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, Zod schemas, DB migrations, and auth utilities for the Guest Profiling System.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "db:migrate": "node-pg-migrate --database-url \"$DATABASE_URL\" --migration-file-format sql up",
    "db:rollback": "node-pg-migrate --database-url \"$DATABASE_URL\" --migration-file-format sql down",
    "db:migrate:create": "node-pg-migrate --migration-file-format sql create"
  },
  "dependencies": {
    "postgres": "^3.4.4",
    "kysely": "^0.27.4",
    "zod": "^3.23.8",
    "jose": "^5.6.3",
    "argon2": "^0.40.3"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "pg-mem": "^3.0.14",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.5.0"
  }
}
